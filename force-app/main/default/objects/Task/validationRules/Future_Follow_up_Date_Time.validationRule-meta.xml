<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Future_Follow_up_Date_Time</fullName>
    <active>false</active>
    <errorConditionFormula>NOT(
    ISBLANK(Follow_Up_Date_Time__c)
) &amp;&amp;
Follow_Up_Date_Time__c &lt;= NOW()</errorConditionFormula>
    <errorDisplayField>Follow_Up_Date_Time__c</errorDisplayField>
    <errorMessage>Please put future follow up date time.</errorMessage>
</ValidationRule>
