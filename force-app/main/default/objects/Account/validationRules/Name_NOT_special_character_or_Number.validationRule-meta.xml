<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Name_NOT_special_character_or_Number</fullName>
    <active>false</active>
    <errorConditionFormula>NOT(REGEX(Name, &quot;^[A-Za-z]+( [A-Za-z]+)*$&quot;))</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>Name field can&apos;t be Number and Special Character</errorMessage>
</ValidationRule>
