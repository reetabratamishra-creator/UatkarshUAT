<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_number_can_only_be_digits</fullName>
    <active>false</active>
    <errorConditionFormula>NOT(REGEX(Phone, &quot;^[0-9]+$&quot;))</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>Phone number can only be digits</errorMessage>
</ValidationRule>
