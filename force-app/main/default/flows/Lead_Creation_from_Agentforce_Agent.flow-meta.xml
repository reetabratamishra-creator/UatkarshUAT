    <description>Lead Creation from Agentforce Agent</description>
    <environments>Default</environments>
    <formulas>
        <name>Formula_FirstName</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS(TRIM({!leadName}), &quot; &quot;),
    LEFT(
        TRIM({!leadName}),
        FIND(&quot; &quot;, TRIM({!leadName})) - 1
    ),
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Formula_LastName</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS(TRIM({!leadName}), &quot; &quot;),
    RIGHT(
        TRIM({!leadName}),
        LEN(TRIM({!leadName})) - FIND(&quot; &quot;, TRIM({!leadName}))
    ),
    TRIM({!leadName})
)</expression>
    </formulas>
