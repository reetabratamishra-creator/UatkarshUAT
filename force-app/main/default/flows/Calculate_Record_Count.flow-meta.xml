<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assign</name>
        <label>assign</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VisitCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TotalMinutes</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>CurrentDurationMinutes</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_on_task_log</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>CurrentDurationMinutes</name>
        <dataType>Number</dataType>
        <expression>VALUE(
    LEFT(
        {!Loop_on_task_log.Time_Duration__c},
        2
    )
) * 60
+
VALUE(
    RIGHT(
        {!Loop_on_task_log.Time_Duration__c},
        2
    )
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>TotalTimeHHMM</name>
        <dataType>String</dataType>
        <expression>LPAD(
    TEXT(
        FLOOR({!TotalMinutes} / 60)
    ),
    2,
    &quot;0&quot;
)
&amp;
&quot;:&quot;
&amp;
LPAD(
    TEXT(
        MOD({!TotalMinutes}, 60)
    ),
    2,
    &quot;0&quot;
)</expression>
    </formulas>
    <interviewLabel>Calculate Record Count {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Calculate Record Count</label>
    <loops>
        <name>Loop_on_task_log</name>
        <label>Loop on task log</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetRecord</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>assign</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>UpdateTask</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
