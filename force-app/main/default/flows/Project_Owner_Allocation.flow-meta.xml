    <formulas>
        <name>deptName_shortForm_Formula</name>
        <dataType>String</dataType>
        <expression>IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;High Mast &amp; Polygonal&apos;) , &apos;HMP&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Steel Pipes&apos;) , &apos;SP&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Polygonal Products&apos;) , &apos;PGP&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Crash Barrier&apos;) , &apos;CB&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Steel Tubular Poles&apos;) , &apos;STP&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Polymer&apos;) , &apos;PVC&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;HDPE&apos;) , &apos;HDPE&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Transmission &amp; Telecom Tower&apos;) , &apos;TTT&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Solar Structure&apos;) , &apos;SS&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Railway Electrification Structure&apos;) , &apos;CORE&apos;,
IF( ISPICKVAL( {!$Record.Department_Name__c} , &apos;Pre Engineering Building&apos;) , &apos;PEB&apos;,

&apos;&apos;)))))))))))</expression>
    </formulas>
    <formulas>
        <name>project_number_formula</name>
        <dataType>String</dataType>
        <expression>&quot;PROJ&quot; + &quot;/&quot; + {!deptName_shortForm_Formula} +&quot;/&quot;+ {!$Record.AutoNumber__c}</expression>
    </formulas>
