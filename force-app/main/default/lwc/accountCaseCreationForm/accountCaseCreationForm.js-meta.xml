<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>New Case for Account</masterLabel>
    <description>Registers a complaint against the account the action was launched from.</description>
    <targets>
        <target>lightning__RecordAction</target>
        <target>lightning__RecordPage</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordAction">
            <actionType>ScreenAction</actionType>
             <objects>
                <object>Account</object>
            </objects>
        </targetConfig>
        
        <targetConfig targets="lightning__RecordPage">
           
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
        <targetConfig targets="lightning__FlowScreen">
        <!-- declare @api properties here, e.g.: -->
        <property name="recordId" type="String" label="Record Id" />
    </targetConfig>
    </targetConfigs>
</LightningComponentBundle>